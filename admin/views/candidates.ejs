<%- include('_top') %>
<form class="filters card" method="get" action="/admin/candidates">
  <div class="search-field"><%- icon('search') %><input type="search" name="q" value="<%= filters.q %>" placeholder="Search name, email or phone"></div>
  <select name="status">
    <option value="">All statuses</option>
    <% statuses.forEach(function (s) { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= statusLabel(s) %></option><% }) %>
  </select>
  <select name="sector">
    <option value="">All sectors</option>
    <% sectors.forEach(function (s) { %><option value="<%= s.slug %>" <%= filters.sector === s.slug ? 'selected' : '' %>><%= s.name %></option><% }) %>
  </select>
  <button class="btn btn-dark" type="submit">Filter</button>
  <a class="btn btn-outline" href="/admin/candidates.csv?q=<%= encodeURIComponent(filters.q) %>&status=<%= filters.status %>&sector=<%= filters.sector %>"><%- icon('download') %> Export CSV</a>
</form>

<section class="card flush">
  <% if (!rows.length) { %><p class="empty pad">No candidates match these filters.</p><% } else { %>
  <div class="table-wrap">
  <table class="table">
    <thead><tr><th>Candidate</th><th>Sector</th><th>Documents</th><th>Status</th><th>Registered</th><th>Last update</th></tr></thead>
    <tbody>
      <% rows.forEach(function (r) { %>
        <tr class="<%= r.active ? '' : 'disabled' %>">
          <td><a href="/admin/candidates/<%= r.id %>"><strong><%= r.name %></strong></a><br><small class="muted"><%= r.email %><%= r.phone ? ' · ' + r.phone : '' %></small><% if (!r.active) { %> <span class="tag tag-rejected">Disabled</span><% } %></td>
          <td><%= sectorName(r.job_sector) %><% if (r.location) { %><br><small class="muted"><%= r.location %></small><% } %></td>
          <td class="docs-cell">
            <span class="chip <%= r.has_cv ? 'on' : '' %>">CV</span>
            <span class="chip <%= r.has_passport ? 'on' : '' %>">Passport</span>
            <span class="chip <%= r.certs ? 'on' : '' %>"><%= r.certs %> cert<%= r.certs === 1 ? '' : 's' %></span>
          </td>
          <td><span class="tag tag-<%= r.status %>"><%= statusLabel(r.status) %></span></td>
          <td><%= fmtDate(r.created_at) %></td>
          <td><%= fmtDate(r.updated_at) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
  <p class="muted small pad"><%= rows.length %> candidate<%= rows.length === 1 ? '' : 's' %></p>
  <% } %>
</section>
<%- include('_bottom') %>
