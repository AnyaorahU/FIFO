<%- include('_top') %>
<p><a href="/admin/jobs" class="link-back">← All jobs</a><% if (job.id) { %> · <a href="/jobs/<%= job.id %>" target="_blank" class="link-back">View on site ↗</a><% } %></p>
<div class="admin-grid wide-left">
  <section class="card">
    <div class="card-head"><h2><%= job.id ? 'Edit job' : 'New job' %></h2></div>
    <form method="post" action="<%= job.id ? '/admin/jobs/' + job.id : '/admin/jobs' %>" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Job title<input name="title" required maxlength="140" value="<%= job.title || '' %>" placeholder="e.g. Forklift Driver"></label>
      <div class="row2">
        <label>Sector
          <select name="sector" required><option value="">Select…</option><% sectors.forEach(function (s) { %><option value="<%= s.slug %>" <%= job.sector === s.slug ? 'selected' : '' %>><%= s.name %></option><% }) %></select>
        </label>
        <label>Work type
          <select name="contract_type" required><option value="">Select…</option><% CONTRACT_TYPES.forEach(function (t) { %><option <%= job.contract_type === t ? 'selected' : '' %>><%= t %></option><% }) %></select>
        </label>
      </div>
      <div class="row3">
        <label>Location<input name="location" required maxlength="120" value="<%= job.location || '' %>" placeholder="e.g. Brisbane - South"></label>
        <label>State / region <span class="hint">(optional)</span><input name="state" maxlength="80" value="<%= job.state || '' %>" placeholder="e.g. WA, Pilbara, Alberta"></label>
        <label>Country<%- include('partials/country-select', { name: 'country', selected: job.country, required: true }) %></label>
      </div>
      <label>Pay <span class="hint">(optional; used for salary filters)</span><input name="pay" maxlength="80" value="<%= job.pay || '' %>" placeholder="$33/hr + penalties, or $95,000"></label>
      <label>Summary <span class="hint">(shown on job cards, 1–3 sentences)</span><textarea name="summary" rows="2" required maxlength="400"><%= job.summary || '' %></textarea></label>
      <label>Description <span class="hint">(blank line between paragraphs)</span><textarea name="description" rows="8" required maxlength="8000"><%= job.description || '' %></textarea></label>
      <label>Requirements <span class="hint">(one per line)</span><textarea name="requirements" rows="5" maxlength="3000"><%= job.requirements || '' %></textarea></label>
      <label class="check"><input type="checkbox" name="featured" value="on" <%= job.featured ? 'checked' : '' %>> Feature on home page (shown first in "Discover our opportunities")</label>
      <label>Status
        <select name="status"><option value="open" <%= job.status !== 'closed' ? 'selected' : '' %>>Open (visible on site)</option><option value="closed" <%= job.status === 'closed' ? 'selected' : '' %>>Closed (hidden from search)</option></select>
      </label>
      <button class="btn btn-primary" type="submit"><%= job.id ? 'Save job' : 'Publish job' %></button>
    </form>
    <% if (job.id) { %>
      <form method="post" action="/admin/jobs/<%= job.id %>/delete" data-confirm="Delete this job and all its applications? This cannot be undone.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-danger" type="submit"><%- icon('trash') %> Delete job</button>
      </form>
    <% } %>
  </section>
  <% if (applicants) { %>
  <section class="card">
    <div class="card-head"><h2>Applicants (<%= applicants.length %>)</h2></div>
    <% if (!applicants.length) { %><p class="empty">No applications yet.</p><% } %>
    <ul class="applicant-list">
      <% applicants.forEach(function (a) { %>
        <li>
          <div class="applicant-top">
            <div><a href="/admin/candidates/<%= a.user_id %>"><strong><%= a.name %></strong></a><br><small class="muted"><%= a.email %><%= a.phone ? ' · ' + a.phone : '' %></small></div>
            <span class="tag tag-<%= a.profile_status %>"><%= statusLabel(a.profile_status) %></span>
          </div>
          <small class="muted">Applied <%= fmtDateTime(a.created_at) %> · CV <%= a.has_cv ? '✓' : '✗' %><%= a.work_rights ? ' · ' + constants.WORK_RIGHTS[a.work_rights] : '' %></small>
          <% if (a.note) { %><p class="pre note"><%= a.note %></p><% } %>
          <form method="post" action="/admin/job-applications/<%= a.id %>/status" class="inline-status">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="back" value="/admin/jobs/<%= job.id %>">
            <select name="status"><% Object.keys(APP_STATUS).forEach(function (k) { %><option value="<%= k %>" <%= a.status === k ? 'selected' : '' %>><%= APP_STATUS[k] %></option><% }) %></select>
            <button class="btn btn-outline btn-sm" type="submit">Update</button>
          </form>
        </li>
      <% }) %>
    </ul>
  </section>
  <% } %>
</div>
<%- include('_bottom') %>
