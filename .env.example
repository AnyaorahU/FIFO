# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development

# --- Database (MongoDB Atlas) ---
# Atlas > Connect > Drivers. Use a database user that only has readWrite on this database.
# URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<your-cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=fifoconnect

# --- Sessions & login protection ---
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_IDLE_MINUTES=120
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# --- Admin area ---
# Admin account created by `npm run seed` (12+ characters with letters and numbers)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_IDLE_MINUTES=30
ADMIN_MAX_SESSION_HOURS=12
# Optional: comma-separated IPs allowed to open /admin (everyone else gets a 404). Leave blank to allow all.
ADMIN_IP_ALLOWLIST=

# --- Seed data defaults (editable later in Admin > Content > Site settings) ---
SITE_NAME=FIFOconnect
SITE_PHONE=
SITE_EMAIL=
# Optional demo candidate created by `npm run seed` (a random password is printed if left blank)
DEMO_CANDIDATE_EMAIL=candidate@example.com
DEMO_CANDIDATE_PASSWORD=

# --- Uploads & map ---
MAX_UPLOAD_MB=10
# Map tiles for the branch map (defaults to OpenStreetMap; use a commercial provider for heavy traffic)
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=

# --- Tests (npm test) ---
# A throwaway MongoDB; the test database is wiped on every run. Never point this at production.
MONGODB_URI_TEST=
