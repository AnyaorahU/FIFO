<%- include('partials/header') %>
<section class="page-hero dark">
  <div class="container">
    <span class="eyebrow">For employers</span>
    <h1>workers, when you need them</h1>
    <p class="lead">
      Recruitment and workforce solutions for Australian businesses of every
      size.
    </p>
    <a href="/contact" class="btn btn-primary"
      >Request staff <%- icon('arrow') %></a
    >
  </div>
</section>
<section class="section" id="services">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">Hire talent</span>
        <h2>Recruitment services</h2>
      </div>
    </div>
    <div class="sector-grid">
      <div class="sector-card static">
        <span class="sector-icon"><%- icon('clock') %></span>
        <h3>Temporary staffing</h3>
        <p>
          Reliable, inducted workers for peaks, projects and cover — at short
          notice.
        </p>
      </div>
      <div class="sector-card static">
        <span class="sector-icon"><%- icon('briefcase') %></span>
        <h3>Permanent recruitment</h3>
        <p>Specialist search for permanent hires from operators to managers.</p>
      </div>
      <div class="sector-card static">
        <span class="sector-icon"><%- icon('passport') %></span>
        <h3>International recruitment</h3>
        <p>
          Skilled workers from overseas, with documentation checked up front.
        </p>
      </div>
      <div class="sector-card static">
        <span class="sector-icon"><%- icon('users') %></span>
        <h3>Onsite teams</h3>
        <p>
          A dedicated consultant on your site managing your contingent
          workforce.
        </p>
      </div>
      <div class="sector-card static">
        <span class="sector-icon"><%- icon('file') %></span>
        <h3>Payroll &amp; outsourcing</h3>
        <p>
          We handle pay, awards, compliance and reporting so you don't have to.
        </p>
      </div>
      <div class="sector-card static">
        <span class="sector-icon"><%- icon('shield') %></span>
        <h3>Safety consulting</h3>
        <p>
          Site audits, inductions and safety systems that protect your people.
        </p>
      </div>
    </div>
  </div>
</section>
<section class="section">
  <div class="container">
    <div class="cta-band">
      <div>
        <h2>Tell us what you need</h2>
        <p>A consultant will call you back within one business day.</p>
      </div>
      <a href="/contact" class="btn btn-primary btn-lg">Contact us</a>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
