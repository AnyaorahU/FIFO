<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' | ' : '' %><%= site.name %></title>
  <meta name="description" content="<%= site.metaDescription || site.tagline || site.name %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <% if (typeof stylesheet !== 'undefined') { %><link rel="stylesheet" href="<%= stylesheet %>"><% } %>
  <link rel="icon" href="/img/brand/favicon-64.png" type="image/png">
  <link rel="apple-touch-icon" href="/img/brand/icon-192.png">
  <meta name="theme-color" content="#0b1f4d">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<a class="skip" href="#main">Skip to content</a>
