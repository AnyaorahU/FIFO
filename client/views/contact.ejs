<%- include('partials/header') %>
<%- include('partials/banner', { heading: 'Contact us', intro: "Looking for work or looking to hire? Send us a message and the right consultant will get back to you.", image: '/img/banner-office.jpg', crumbs: [{ label: 'Contact us' }] }) %>
<section class="page-body">
  <div class="container-narrow page-grid">
    <form method="post" action="/contact" class="card form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="seg">
        <label><input type="radio" name="audience" value="candidate" <%= form.audience !== 'employer' ? 'checked' : '' %>> I'm looking for work</label>
        <label><input type="radio" name="audience" value="employer" <%= form.audience === 'employer' ? 'checked' : '' %>> I'm hiring</label>
      </div>
      <div class="row2">
        <label>Full name<input name="name" required maxlength="120" value="<%= form.name || '' %>"></label>
        <label>Phone<input name="phone" type="tel" maxlength="40" value="<%= form.phone || '' %>"></label>
      </div>
      <label>Email<input name="email" type="email" required maxlength="200" value="<%= form.email || '' %>"></label>
      <label>Message<textarea name="body" rows="6" required maxlength="5000"><%= form.body || '' %></textarea></label>
      <button class="btn btn-red" type="submit">Send message</button>
    </form>
    <aside class="side">
      <div class="side-card"><h3>Call us</h3><p><a href="tel:<%= site.phone.replace(/\s/g, '') %>"><%= site.phone %></a></p><h3>Email</h3><p><a href="mailto:<%= site.email %>"><%= site.email %></a></p><h3>Office hours</h3><p>Mon to Fri, 7:30am to 5:30pm</p></div>
      <div class="side-card red"><h3>Hiring?</h3><p>Use our business enquiry form for staffing requests.</p><a class="btn btn-white" href="/companies/enquiry">Business enquiry</a></div>
    </aside>
  </div>
</section>
<%- include('partials/footer') %>
